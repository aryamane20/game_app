{
  "name": "src",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.17",
    "jest": "^30.3.0",
    "jest-expo": "~54.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "utils",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/utils/**/*.test.ts"],
        "transform": {
          "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "strict": true } }]
        }
      },
      {
        "displayName": "components",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/components/**/*.test.tsx",
          "<rootDir>/stores/**/*.test.ts",
          "<rootDir>/hooks/**/*.test.ts"
        ]
      }
    ]
  },
  "private": true
}
